# BookSpace Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (optional - defaults to https://bookspace-be.onrender.com/api)
# For local development, you can use: http://localhost:5000/api
# Note: Vite requires the VITE_ prefix for client-side environment variables
VITE_API_URL=https://bookspace-be.onrender.com/api
