# BookSpace Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL - required for production deployment
# Set this to your deployed backend URL, e.g. https://your-backend.onrender.com/api
# In local development this is NOT needed — Vite proxies /api to http://localhost:10000
# Note: Vite requires the VITE_ prefix for client-side environment variables
VITE_API_URL=https://your-backend.onrender.com/api
