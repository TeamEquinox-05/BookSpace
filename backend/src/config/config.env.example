# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT secret for token signing (use a long random string)
JWT_SECRET=your-random-secret-here

# Email service credentials (for OTP delivery)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Default admin account (created on first run)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourschool.edu
ADMIN_PASS=change-this-password

# Second admin account
ADMIN2_NAME=Admin
ADMIN2_EMAIL=admin2@yourschool.edu
ADMIN2_PASS=change-this-password
